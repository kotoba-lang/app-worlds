(ns worlds.scene-parity-test
  "aiueos/worlds_scene.cljk（判定コア）と正本（registry.ts / types.ts）の
  parity。閉じた集合・既定 status・拒否名が変われば落ちる drift 検査。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            ["fs" :as fs]))

(def types-src
  (fs/readFileSync (str/join "/" ["kotoba" "src" "types.ts"]) "utf8"))
(def registry
  (fs/readFileSync (str/join "/" ["kotoba" "src" "registry.ts"]) "utf8"))

(deftest closed-sets-match-guest
  (testing "guest test-status: SceneStatus の 3 つ（新規は draft から）"
    (doseq [s ["draft" "published" "archived"]]
      (is (str/includes? types-src s)))
    (is (str/includes? registry "draft")))
  (testing "guest test-asset: AssetType の 6 つ"
    (doseq [a ["model" "texture" "audio" "material" "script" "other"]]
      (is (str/includes? types-src a)))))

(deftest admission-rules-match-guest
  (testing "guest test-update / test-fail-closed: 拒否名"
    (is (str/includes? registry "invalidStatus"))
    (is (str/includes? registry "sceneNotFound"))
    (is (str/includes? registry "missingRequiredFields")))
  (testing "guest test-asset-admission: AssetType の検証"
    (is (str/includes? registry "ASSET_TYPES.has")))
  (testing "guest の冪等前提: シーン作成は alreadyExists"
    (is (str/includes? registry "alreadyExists"))))
