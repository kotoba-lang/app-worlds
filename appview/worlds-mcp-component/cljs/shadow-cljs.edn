;; worlds-mcp appview — single-page app, single build/module.
;; Mirrors the wire / slides / yotei cljs layout (appview + CF Worker static assets).
{:deps {:aliases [:cljs]}
 :builds {:app {:target :browser
                :output-dir "public/js"
                :asset-path "js"
                :modules {:app {:init-fn worlds.desktop/init!}}}}}
